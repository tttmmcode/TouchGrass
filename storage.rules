rules_version = '2';

// TouchGrass Cloud Storage security rules.
// Covered by allow + deny cases in firestore-tests/test/storage.test.mjs.
//
// Client deletion is deliberately NOT granted here: account deletion
// (audit D-04) removes a user's files server-side with the Admin SDK
// (functions/src/accountDeletion.ts), which these rules don't apply to.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Raster image types the app produces (camera/gallery JPEG, cropped PNG
    // avatars) plus common phone formats. SVG is excluded on purpose: it can
    // carry script.
    function isAllowedImage() {
      return request.resource.contentType in
        ['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif'];
    }

    // The uploader's profile document still exists (Phase 7F, late-upload
    // window). deleteAccount removes users/{uid} before its final photo
    // sweep, so from then on a device still holding the deleted account's
    // unexpired ID token (up to 1 h) can't add photos the sweep would miss.
    // Profiles are created at sign-in, before any upload is possible.
    // A cross-service read: one Firestore document read per upload that
    // passed every other check (it is evaluated last), and the first deploy
    // grants Storage's service agent read access to Firestore (IAM).
    function hasProfile() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    // ── Profile photos ─────────────────────────────────────────────────────
    // Stored at: user_avatars/{uid}.png. Any signed-in user may GET a single
    // avatar (shown on leaderboards); only the owner may create or replace
    // their own. `get`, not `read`: `read` also grants `list`, which would
    // let anyone enumerate every avatar — i.e. every uid that set a photo
    // (Phase 7B matrix T33; Phase 7C). Covered by
    // firestore-tests/test/storage_release_parity.test.mjs.
    match /user_avatars/{fileName} {
      allow get: if isSignedIn();
      allow create, update: if isSignedIn()
        && fileName == request.auth.uid + '.png'
        && request.resource.size < 5 * 1024 * 1024
        && isAllowedImage()
        && hasProfile();
      allow delete: if false;
    }

    // ── Challenge completion photos ────────────────────────────────────────
    // Stored at: completion_photos/{uid}/{yyyy-MM-dd}.jpg — one fixed object
    // per completion date (audit D-13), so retrying an upload replaces the
    // same file instead of leaving orphans. Private to the owner. Older
    // photos named {timestamp}.jpg stay readable; new writes must use the
    // date name.
    match /completion_photos/{userId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && fileName.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}[.]jpg')
        && request.resource.size < 10 * 1024 * 1024
        && isAllowedImage()
        && hasProfile();
      allow delete: if false;
    }

    // Listing a user's own folder (used to enumerate photos for deletion).
    match /completion_photos/{userId} {
      allow list: if isSignedIn() && request.auth.uid == userId;
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
