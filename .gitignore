# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Operator tool output (object names / uids) and credentials — never commit (Phase 6)
ops-out/
*.p12
*.pem
*-service-account*.json
service-account*.json
.env
.env.*

# Local secrets — never commit
secrets.json
key.properties
*.jks
*.keystore
android/local.properties

# Cloud Functions (functions/) — Node build artifacts and local env files.
# The Gemini secret itself is never stored in a file at all — see
# functions/README.md, it's set via `firebase functions:secrets:set`.
functions/node_modules/
firestore-tests/node_modules/
firestore-tests/*.log
functions/lib/
functions/.env
functions/.env.*
functions/*.log

# Firebase CLI's local deploy cache (hosting hash cache, per-machine,
# regenerated automatically) — no reason to version it.
.firebase/

# Phase 7A: the iOS Maps key (copy ios/Flutter/MapsApiKey.xcconfig.example).
ios/Flutter/MapsApiKey.xcconfig

# Phase 8: generated non-production rules and the dev Hosting build
deploy/dev/generated/
deploy/dev/public/
e2e/node_modules/
e2e/artifacts/
